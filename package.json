{
  "name": "@cedulon/workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test:all": "node --experimental-strip-types --test tests/fail-closed.test.ts tests/policy.test.ts tests/replay-manifest.test.ts tests/receipts-demo.test.ts tests/cose.test.ts tests/checkpoint.test.ts tests/audit.test.ts",
    "tamper": "node --experimental-strip-types examples/demo/src/tamper.ts",
    "demo": "node --experimental-strip-types examples/demo/src/cli.ts",
    "demo:unguarded": "node --experimental-strip-types examples/demo/src/unguarded.ts",
    "demo:bypass": "node --experimental-strip-types examples/demo/src/bypass.ts",
    "audit": "node --experimental-strip-types examples/demo/src/audit-cli.ts",
    "demo:export": "node --experimental-strip-types examples/demo/src/export.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "cbor-x": "^1.6.0",
    "typescript": "^5.8.3"
  }
}
