# Every variable the code reads. Empty means "use the built-in default".
# tests/env-example.test.ts compares this list against the source, so a new
# variable that never reaches this file fails the suite.

# Policy the MCP server starts with.
CEDULON_MAX_AMOUNT=
CEDULON_MAX_CUMULATIVE=
CEDULON_MAX_PAYMENTS=
CEDULON_WINDOW_MS=
CEDULON_ALLOWED_PAYEES=
CEDULON_ALLOWED_CURRENCIES=
CEDULON_ALLOWED_TOOLS=
CEDULON_PAYER=

# Where the session persists receipts, checkpoints and its signing key.
# The file is written owner-only; leave unset to keep everything in memory.
CEDULON_STATE_PATH=

# Read-only chain access for the live reconciliation demo.
CEDULON_RPC_URL=

# Phase 2 write path. Broadcast stays off unless it is set explicitly, and the
# key is read from a file rather than an environment string wherever possible.
CEDULON_ALLOW_BROADCAST=
CEDULON_WRITE_KEY_FILE=
CEDULON_WRITE_KEY=
CEDULON_WRITE_FROM=
