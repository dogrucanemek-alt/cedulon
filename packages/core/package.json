{
  "name": "@cedulon/core",
  "version": "0.1.0",
  "description": "Fail-closed spend policy engine and decision tokens for Cedulon.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dogrucanemek-alt/cedulon.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/dogrucanemek-alt/cedulon/tree/master/packages/core",
  "bugs": {
    "url": "https://github.com/dogrucanemek-alt/cedulon/issues"
  },
  "keywords": [
    "cedulon",
    "policy",
    "fail-closed"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@cedulon/cose": "^0.1.0"
  }
}
