{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedulon.com/schema/finding-object-v1.json",
  "title": "Cedulon finding object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findingObjectVersion",
    "ok",
    "guarantee",
    "summary",
    "receipts",
    "findings",
    "warnings"
  ],
  "properties": {
    "findingObjectVersion": { "type": "integer", "const": 1 },
    "ok": { "type": "boolean" },
    "guarantee": { "type": "string", "enum": ["unconditional", "conditional"] },
    "summary": { "type": "string", "minLength": 1 },
    "receipts": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "scope": { "$ref": "#/$defs/scope" },
    "counts": { "$ref": "#/$defs/counts" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipts", "settlements"],
      "properties": {
        "receipts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submitted",
            "attested",
            "inScope",
            "aborted",
            "settled",
            "matched",
            "deferred",
            "carried",
            "unmatched",
            "repeated",
            "unreconciled"
          ],
          "properties": {
            "submitted": { "$ref": "#/$defs/count" },
            "attested": { "$ref": "#/$defs/count" },
            "inScope": { "$ref": "#/$defs/count" },
            "aborted": { "$ref": "#/$defs/count" },
            "settled": { "$ref": "#/$defs/count" },
            "matched": { "$ref": "#/$defs/count" },
            "deferred": { "$ref": "#/$defs/count" },
            "carried": { "$ref": "#/$defs/count" },
            "unmatched": { "$ref": "#/$defs/count" },
            "repeated": { "$ref": "#/$defs/count" },
            "unreconciled": { "$ref": "#/$defs/count" }
          }
        },
        "settlements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "matched", "deferred", "unmatched", "repeated", "unreconciled"],
          "properties": {
            "rows": { "$ref": "#/$defs/count" },
            "matched": { "$ref": "#/$defs/count" },
            "deferred": { "$ref": "#/$defs/count" },
            "unmatched": { "$ref": "#/$defs/count" },
            "repeated": { "$ref": "#/$defs/count" },
            "unreconciled": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "railId", "windowStartMs", "windowEndMs"],
      "properties": {
        "accountId": { "type": "string", "minLength": 1 },
        "railId": { "type": "string", "minLength": 1 },
        "windowStartMs": { "type": "integer" },
        "windowEndMs": { "type": "integer" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "id", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["fail", "warn"] }
      }
    }
  }
}
