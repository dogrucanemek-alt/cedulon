{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedulon.com/schema/finding-object-v1.json",
  "title": "Cedulon finding object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findingObjectVersion",
    "ok",
    "guarantee",
    "summary",
    "receipts",
    "findings",
    "warnings"
  ],
  "properties": {
    "findingObjectVersion": { "type": "integer", "const": 1 },
    "ok": { "type": "boolean" },
    "guarantee": { "type": "string", "enum": ["unconditional", "conditional"] },
    "summary": { "type": "string", "minLength": 1 },
    "receipts": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "scope": { "$ref": "#/$defs/scope" },
    "counts": { "$ref": "#/$defs/counts" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipts", "settlements"],
      "properties": {
        "receipts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submitted",
            "attested",
            "inScope",
            "aborted",
            "settled",
            "matched",
            "deferred",
            "carried",
            "unmatched",
            "repeated",
            "unreconciled"
          ],
          "properties": {
            "submitted": { "$ref": "#/$defs/count" },
            "attested": { "$ref": "#/$defs/count" },
            "inScope": { "$ref": "#/$defs/count" },
            "aborted": { "$ref": "#/$defs/count" },
            "settled": { "$ref": "#/$defs/count" },
            "matched": { "$ref": "#/$defs/count" },
            "deferred": { "$ref": "#/$defs/count" },
            "carried": { "$ref": "#/$defs/count" },
            "unmatched": { "$ref": "#/$defs/count" },
            "repeated": { "$ref": "#/$defs/count" },
            "unreconciled": { "$ref": "#/$defs/count" }
          }
        },
        "settlements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "matched", "deferred", "unmatched", "repeated", "unreconciled"],
          "properties": {
            "rows": { "$ref": "#/$defs/count" },
            "matched": { "$ref": "#/$defs/count" },
            "deferred": { "$ref": "#/$defs/count" },
            "unmatched": { "$ref": "#/$defs/count" },
            "repeated": { "$ref": "#/$defs/count" },
            "unreconciled": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "railId", "windowStartMs", "windowEndMs"],
      "properties": {
        "accountId": { "type": "string", "minLength": 1 },
        "railId": { "type": "string", "minLength": 1 },
        "windowStartMs": { "type": "integer" },
        "windowEndMs": { "type": "integer" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "id", "detail"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "settlement-without-receipt",
            "receipt-without-settlement",
            "receipt-chain-break",
            "checkpoint-total-mismatch",
            "checkpoint-head-mismatch",
            "duplicate-ref",
            "settlement-mismatch",
            "equivocation",
            "window-coverage",
            "settled-without-ref",
            "unauthenticated-extract",
            "unauthenticated-issuer",
            "unauthenticated-witness",
            "unauthenticated-countersigner",
            "unauthenticated-manifest",
            "countersign-missing",
            "witness-entry-unattributable",
            "issuer-key-mismatch",
            "countersign-key-mismatch",
            "extract-key-mismatch",
            "manifest-key-mismatch",
            "manifest-covers-no-receipt",
            "manifest-terms-mismatch",
            "extract-scope-mismatch",
            "extract-settlement-mismatch",
            "settlement-comparison-skipped",
            "trust-key-unreadable",
            "unstated-audit-window",
            "unstated-audit-scope",
            "malformed-amount",
            "malformed-policy-hash",
            "malformed-request-hash",
            "malformed-acceptance-criteria-hash",
            "malformed-manifest-hash",
            "malformed-receipt-hash",
            "malformed-prev-receipt-hash",
            "malformed-chain-head-hash",
            "malformed-prev-checkpoint-hash",
            "malformed-ap-two-mandate-hash",
            "countersign-bad",
            "checkpoint-not-anchored",
            "checkpoint-withheld",
            "checkpoint-totals-redacted",
            "carried-key-mismatch",
            "boundary-deferred",
            "beneficiary-mismatch",
            "counterparty-unbound",
            "delivery-mismatch",
            "witness-inclusion-invalid",
            "witness-inclusion-not-exercised",
            "decision-without-effect",
            "effect-without-decision",
            "effect-against-refusal",
            "effect-mismatch",
            "effect-class-mismatch"
          ]
        },
        "id": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["fail", "warn"] }
      }
    }
  }
}
